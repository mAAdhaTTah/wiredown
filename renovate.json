{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Gitea image the end-to-end tests run (packages/gitea/tests/gitea/gitea.ts)",
      "managerFilePatterns": ["/^packages/gitea/tests/gitea/gitea\\.ts$/"],
      "matchStrings": ["\"docker\\.io/(?<depName>gitea/gitea):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ]
}
