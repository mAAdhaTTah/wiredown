{
  "name": "wiredown",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:obsidian": "pnpm --filter \"@wiredown/obsidian-plugin...\" build && pnpm --filter @wiredown/excalidraw test:obsidian",
    "eval": "vitest run --config packages/evals/vitest.eval.config.ts",
    "eval:reveal": "node packages/evals/src/reveal.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skill": "node scripts/skill.mjs"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@wiredown/cli": "workspace:*",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "rolldown-plugin-dts": "^0.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
