{
  "name": "@wiredown/excalidraw",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@wiredown/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "@wiredown/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:obsidian": "vitest run --config vitest.obsidian.config.ts"
  },
  "dependencies": {
    "@wiredown/core": "workspace:*",
    "fractional-indexing": "^4.0.0",
    "lz-string": "^1.5.0"
  },
  "peerDependencies": {
    "happy-dom": "^21.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "woff2-encoder": "^2.0.0",
    "@excalidraw/utils": "0.1.8"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    },
    "woff2-encoder": {
      "optional": true
    },
    "@excalidraw/utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "woff2-encoder": "^2.0.0",
    "@excalidraw/utils": "0.1.8"
  }
}
